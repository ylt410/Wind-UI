    local okPatchedCache, cachedResult = pcall(yeCompileAndRun, patchedCache)
    if okPatchedCache then
        return cachedResult
    end
    warn("[WindUI YePerf] patched cache failed; ignoring it: " .. tostring(cachedResult))
end

-- Second path: use cached official source and patch it locally.
local coreSource = yeReadFile(YE_CORE_CACHE)

if not yeSourceCompiles(coreSource) then
    print("[WindUI YePerf] downloading official WindUI v" .. YE_WINDUI_BASE_VERSION)

    local fetched, fetchError =
        yeHttpGetWithTimeout(YE_OFFICIAL_URL, YE_CORE_HTTP_TIMEOUT)

    if not yeSourceCompiles(fetched) then
        local okFallback, fallback = pcall(yeHttpGet, YE_OFFICIAL_URL)

        if okFallback and yeSourceCompiles(fallback) then
            fetched = fallback
        else
            error(
                "[WindUI YePerf] official WindUI could not be downloaded/compiled: "
                    .. tostring(fetchError or (okFallback and "compile failed" or fallback)),
                0
            )
        end
    end

    coreSource = fetched
    yeWriteFile(YE_CORE_CACHE, coreSource)
else
    print("[WindUI YePerf] using cached official source")
end

