local function boundaryState(s,p)
local delay
if targetAbove then
delay=s*0.055
else
delay=(1-s)*0.055
end

local localP=YE_GenieClamp01((p-delay)/(1-delay))
local e=YE_GenieEaseOut(localP)
local arch=math.sin(math.pi*e)
local startY=startPos.Y+s*startSize.Y
local endY=targetTop+s*targetSize.Y
local y=YE_GenieLerp(startY,endY,e)
local x=YE_GenieLerp(startCenter.X,targetCenter.X,e)

