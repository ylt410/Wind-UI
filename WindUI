-- boundary point, this bends the window without pulling the pieces apart.
local wave=math.sin((s-0.5)*math.pi)
local bend=wave*maxBend*arch

if mostlyVertical then
x=x+bend
else
y=y+bend*0.30
end

local width=YE_GenieLerp(startSize.X,targetSize.X,e)
local centerPinch=math.sin(math.pi*s)
local pinch=1-(0.055*centerPinch*centerPinch*arch)
width=math.max(4,width*pinch)

return {
X=x,
Y=y,
Width=width,
E=e,
}
end

