-- ============================================================
-- Legacy v1.6.62 Dropdown full sizing compatibility
--
-- Newer WindUI creates MenuCanvas at 300px high and relies on an immediate
-- AbsoluteContentSize read to shrink it. With faster element creation that
-- read can happen before Roblox finishes the layout pass, leaving a menu
-- visibly taller than its options. The old UI effectively behaved as
-- content-driven: short lists stayed short, long lists grew until the
-- viewport cap, then scrolled.
--
-- This is installed after WindUI loads, so it survives source minification
-- changes and also works on the untouched-official fail-open path.
-- ============================================================
local YE_LegacyDropdownRunService=game:GetService"RunService"

local function yeLegacyDropdownMeasureWidth(dropdown)
    local ui=dropdown and dropdown.UIElements
    local menuCanvas=ui and ui.MenuCanvas

    if not menuCanvas then
        return nil
    end

    -- Old WindUI rule:
    -- explicit MenuWidth wins; otherwise measure the widest option.
    if dropdown.YeLegacyMenuWidthExplicit then
        local explicit=tonumber(dropdown.YeLegacyMenuWidthValue)
        if explicit then
            return explicit
        end
    end

    local maxContentWidth=0

    if type(dropdown.Tabs)=="table" then
        for _,tab in next,dropdown.Tabs do
            local item=tab
                and tab.UIElements
                and tab.UIElements.TabItem

            local frame=item and item:FindFirstChild"Frame"
            local layout=frame and frame:FindFirstChildOfClass"UIListLayout"

            if layout then
                maxContentWidth=math.max(
                    maxContentWidth,
                    layout.AbsoluteContentSize.X
                )
            end
        end
    end

    -- v1.6.62 added exactly 52px around the measured option content:
    -- 6 + 6 + 5 + 5 + 18 + 6 + 6
    local target=maxContentWidth+52

    local constraint=menuCanvas:FindFirstChildOfClass"UISizeConstraint"
    local minWidth=170
    local maxWidth=300

    if constraint then
        if constraint.MinSize.X>0 then
            minWidth=constraint.MinSize.X
        end
        if constraint.MaxSize.X>0 then
            maxWidth=constraint.MaxSize.X
        end
    end

    return math.clamp(target,minWidth,maxWidth)
end

local function yeLegacyDropdownReflow(dropdown)
    if type(dropdown)~="table" then
        return
    end

    local ui=dropdown.UIElements
    local menuCanvas=ui and ui.MenuCanvas
    local listLayout=ui and ui.UIListLayout
    local menu=ui and ui.Menu

    if not menuCanvas
        or not listLayout
        or not menuCanvas.Parent
        or not listLayout.Parent then
        return
    end

    local contentY=listLayout.AbsoluteContentSize.Y

    -- v1.6.62 vertical padding behavior.
    local menuPadding=5
    local paddingObject=menu:FindFirstChildOfClass"UIPadding"

    if paddingObject then
        local top=paddingObject.PaddingTop.Offset
        local bottom=paddingObject.PaddingBottom.Offset

        if top>0 then
            menuPadding=top
        elseif bottom>0 then
            menuPadding=bottom
        end
    end

    local extraY=menuPadding*2

    if dropdown.SearchBarEnabled then
        local searchBar=menu:FindFirstChild"SearchBar"
        local searchHeight=39

        if searchBar and searchBar.AbsoluteSize.Y>1 then
            searchHeight=searchBar.AbsoluteSize.Y
        end

        extraY=searchHeight+(menuPadding*3)
    end

    local camera=workspace.CurrentCamera
    local maxHeight=(camera and camera.ViewportSize.Y or 720)*0.6

    local constraint=menuCanvas:FindFirstChildOfClass"UISizeConstraint"
    if constraint and constraint.MaxSize.Y>0 then
        maxHeight=math.min(maxHeight,constraint.MaxSize.Y)
    end

    local targetHeight=math.clamp(contentY+extraY,0,maxHeight)
    local targetWidth=yeLegacyDropdownMeasureWidth(dropdown)
        or menuCanvas.AbsoluteSize.X

    menuCanvas.Size=UDim2.fromOffset(targetWidth,targetHeight)

    local frame=menu and menu:FindFirstChild"Frame"
    local scrollingFrame=frame and frame:FindFirstChildOfClass"ScrollingFrame"

    if scrollingFrame then
        scrollingFrame.CanvasSize=UDim2.fromOffset(0,contentY)
    end
end

local function yeLegacyDropdownQueueReflow(dropdown,waitFrame)
    task.defer(function()
        if waitFrame then
            YE_LegacyDropdownRunService.Heartbeat:Wait()
        end

        pcall(yeLegacyDropdownReflow,dropdown)
    end)
end

local function yeInstallLegacyDropdown(dropdown)
    if type(dropdown)~="table"
        or dropdown.__type~="Dropdown"
        or dropdown.YeLegacyDropdownAutosize then
        return dropdown
    end

    local ui=dropdown.UIElements
    local listLayout=ui and ui.UIListLayout

    if not listLayout then
        return dropdown
    end

    dropdown.YeLegacyDropdownAutosize=true
    dropdown.YeLegacyDropdownWidthConnections={}

    local function hookOptionWidths()
        if type(dropdown.Tabs)~="table" then
            return
        end

        for _,tab in next,dropdown.Tabs do
            local item=tab
                and tab.UIElements
                and tab.UIElements.TabItem
            local frame=item and item:FindFirstChild"Frame"
            local layout=frame and frame:FindFirstChildOfClass"UIListLayout"

            if layout and not dropdown.YeLegacyDropdownWidthConnections[layout] then
                local okConn,conn=pcall(function()
                    return layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                        yeLegacyDropdownQueueReflow(dropdown,false)
                    end)
                end)

                if okConn then
                    dropdown.YeLegacyDropdownWidthConnections[layout]=conn
                end
            end
        end
    end

    local okConnection,connection=pcall(function()
        return listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            yeLegacyDropdownQueueReflow(dropdown,false)
        end)
    end)

    if okConnection then
        dropdown.YeLegacyDropdownAutosizeConnection=connection
    end

    if type(dropdown.Open)=="function" then
        local originalOpen=dropdown.Open

        dropdown.Open=function(self,...)
            hookOptionWidths()
            pcall(yeLegacyDropdownReflow,self)
            local results=table.pack(originalOpen(self,...))
            yeLegacyDropdownQueueReflow(self,true)
            return table.unpack(results,1,results.n)
        end
    end

    if type(dropdown.Refresh)=="function" then
        local originalRefresh=dropdown.Refresh

        dropdown.Refresh=function(self,...)
            local results=table.pack(originalRefresh(self,...))
            hookOptionWidths()
            yeLegacyDropdownQueueReflow(self,true)
            return table.unpack(results,1,results.n)
        end
    end

    hookOptionWidths()
    pcall(yeLegacyDropdownReflow,dropdown)
    yeLegacyDropdownQueueReflow(dropdown,true)

    return dropdown
end

local function yeInstallLegacyDropdownContainer(container)
    if type(container)~="table" or container.YeLegacyDropdownContainer then
        return container
    end

    container.YeLegacyDropdownContainer=true

    if type(container.Dropdown)=="function" then
        local originalDropdown=container.Dropdown

        container.Dropdown=function(self,config)
            config=config or {}

            local hadExplicitMenuWidth=config.MenuWidth~=nil
            local explicitMenuWidth=config.MenuWidth

            local dropdown=originalDropdown(self,config)

            if type(dropdown)=="table" then
                dropdown.YeLegacyMenuWidthExplicit=hadExplicitMenuWidth
                dropdown.YeLegacyMenuWidthValue=explicitMenuWidth
            end

            yeInstallLegacyDropdown(dropdown)
            return dropdown
        end
    end

    -- WindUI can nest elements in Sections/Groups/stacks. Wrap those return
    -- objects too so Dropdowns do not revert to the new fixed-looking height
    -- merely because they live one level deeper.
    for _,methodName in ipairs({"Section","Group","HStack","VStack"})do
        local original=container[methodName]

        if type(original)=="function" then
            container[methodName]=function(self,...)
                local child=original(self,...)
                yeInstallLegacyDropdownContainer(child)
                return child
            end
        end
    end

    return container
end

local function yeInstallLegacyDropdownOnLibrary(library)
    if type(library)~="table"
        or library.YeLegacyDropdownLibrary
        or type(library.CreateWindow)~="function" then
        return library
    end

    library.YeLegacyDropdownLibrary=true

    local originalCreateWindow=library.CreateWindow

    library.CreateWindow=function(self,config)
        local window=originalCreateWindow(self,config)

        if type(window)=="table" and not window.YeLegacyDropdownWindow then
            window.YeLegacyDropdownWindow=true

            if type(window.Tab)=="function" then
                local originalTab=window.Tab

                window.Tab=function(win,tabConfig)
                    local tab=originalTab(win,tabConfig)
                    yeInstallLegacyDropdownContainer(tab)
                    return tab
                end
            end

            -- Sidebar sections can also expose element containers depending on
            -- WindUI version/config, so make this harmlessly recursive too.
            yeInstallLegacyDropdownContainer(window)
        end

        return window
    end

    return library
end

local function yeCompileAndRun(source)
    local compileOk, chunkOrError = pcall(function()
        return loadstring(source)
    end)

    if not compileOk or type(chunkOrError) ~= "function" then
        error(
            "[WindUI YePerf] compile failed: " .. tostring(chunkOrError),
            0
        )
    end

    local runOk, libraryOrError = pcall(chunkOrError)

    if not runOk then
        error(
            "[WindUI YePerf] execution failed: " .. tostring(libraryOrError),
            0
        )
    end

    if type(libraryOrError) ~= "table"
        or type(libraryOrError.CreateWindow) ~= "function" then
        error(
            "[WindUI YePerf] official library returned an invalid object",
            0
        )
    end

    libraryOrError.YeOptimized = true
    libraryOrError.YeOptimizationVersion = YE_WINDUI_PATCH_ID
    libraryOrError.YeBaseVersion = YE_WINDUI_BASE_VERSION

    -- Restore the original v1.6.62 content-driven Dropdown width and height.
    -- This runtime hook is intentionally independent from source patch
    -- signatures, so a skipped optimization patch cannot remove it.
    yeInstallLegacyDropdownOnLibrary(libraryOrError)

    return libraryOrError
end

-- Fastest path: execute an already-patched local copy.
local patchedCache = yeReadFile(YE_PATCHED_CACHE)

if yeLooksLikePatchedSource(patchedCache) and yeSourceCompiles(patchedCache) then
    print("[WindUI YePerf] using patched local cache")
    local okPatchedCache, cachedResult = pcall(yeCompileAndRun, patchedCache)
    if okPatchedCache then
        return cachedResult
    end
    warn("[WindUI YePerf] patched cache failed; ignoring it: " .. tostring(cachedResult))
end

-- Second path: use cached official source and patch it locally.
local coreSource = yeReadFile(YE_CORE_CACHE)

if not yeSourceCompiles(coreSource) then
    print("[WindUI YePerf] downloading official WindUI v" .. YE_WINDUI_BASE_VERSION)

    local fetched, fetchError =
        yeHttpGetWithTimeout(YE_OFFICIAL_URL, YE_CORE_HTTP_TIMEOUT)

    if not yeSourceCompiles(fetched) then
        local okFallback, fallback = pcall(yeHttpGet, YE_OFFICIAL_URL)

        if okFallback and yeSourceCompiles(fallback) then
            fetched = fallback
        else
            error(
                "[WindUI YePerf] official WindUI could not be downloaded/compiled: "
                    .. tostring(fetchError or (okFallback and "compile failed" or fallback)),
                0
            )
        end
    end

    coreSource = fetched
    yeWriteFile(YE_CORE_CACHE, coreSource)
else
    print("[WindUI YePerf] using cached official source")
end

local patchOk, optimizedSource = pcall(yePatchWindUI, coreSource)

if not patchOk or type(optimizedSource) ~= "string" then
    warn("[WindUI YePerf] optimizer failed; starting untouched official WindUI: " .. tostring(optimizedSource))
    optimizedSource = coreSource
end

local runOk, result = pcall(yeCompileAndRun, optimizedSource)

if runOk then
    if optimizedSource ~= coreSource and yeLooksLikePatchedSource(optimizedSource) then
        yeWriteFile(YE_PATCHED_CACHE, optimizedSource)
    end
    return result
end

if optimizedSource ~= coreSource then
    warn("[WindUI YePerf] optimized build failed; falling back to untouched official WindUI: " .. tostring(result))
    return yeCompileAndRun(coreSource)
end

error(tostring(result), 0)
