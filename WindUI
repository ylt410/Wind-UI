local function YE_GenieCreateMorph(windowRoot,buttonInfo)
local shell=windowRoot and windowRoot.Background
local screen=av.WindUI and av.WindUI.ScreenGui
if not windowRoot or not shell or not buttonInfo or not screen then
return nil
end

local windowSize=windowRoot.AbsoluteSize
if windowSize.X<8 or windowSize.Y<8 then
local globalScale=av.WindUI.UIScale or 1
windowSize=Vector2.new(
math.max(8,aw.Size.X.Offset*globalScale),
math.max(8,aw.Size.Y.Offset*globalScale)
)
end

local windowCenter=YE_GenieResolveCenter(windowRoot,windowSize)
if not windowCenter then
return nil
end

local group=Instance.new"CanvasGroup"
group.Name="YeGenieJellyGlowMorph"
group.BackgroundTransparency=1
group.GroupTransparency=0
group.AnchorPoint=Vector2.new(0.5,0.5)
group.ClipsDescendants=false
group.ZIndex=100000
group.Parent=screen

local glow=YE_GenieMakeGlow(group,100005)
local windowLayer=YE_GenieMakeWindowLayer(group,shell,100010)
local buttonLayer=YE_GenieMakeButtonLayer(group,buttonInfo.Button,100020)
local impactDirection=YE_GenieDirection(windowCenter,buttonInfo.Center)

return {
Group=group,
Glow=glow,
WindowLayer=windowLayer,
ButtonLayer=buttonLayer,
WindowCenter=windowCenter,
WindowSize=windowSize,
ButtonCenter=buttonInfo.Center,
ButtonSize=buttonInfo.Size,
ImpactDirection=impactDirection,
RestoreDirection=-impactDirection,
}
end

local function YE_GenieApplyGeometry(morph,positionProgress,visualScale,centerOffset,sizeProgress,layerMix)
local pp=YE_GenieClamp01(positionProgress)
local sp=YE_GenieClamp01(sizeProgress==nil and pp or sizeProgress)
local scale=visualScale or 1
local offset=centerOffset or Vector2.zero

local cx=YE_GenieLerp(morph.WindowCenter.X,morph.ButtonCenter.X,pp)+offset.X
local cy=YE_GenieLerp(morph.WindowCenter.Y,morph.ButtonCenter.Y,pp)+offset.Y
local w=YE_GenieLerp(morph.WindowSize.X,morph.ButtonSize.X,sp)*scale
local h=YE_GenieLerp(morph.WindowSize.Y,morph.ButtonSize.Y,sp)*scale

morph.Group.Position=UDim2.fromOffset(cx,cy)
morph.Group.Size=UDim2.fromOffset(math.max(4,w),math.max(4,h))

local mix
if layerMix==nil then
mix=YE_GenieClamp01((sp-0.72)/0.28)
else
mix=YE_GenieClamp01(layerMix)
end

morph.WindowLayer.GroupTransparency=mix
morph.ButtonLayer.GroupTransparency=1-mix
end

local function YE_GenieRunMorph(morph,reverse,duration)
local started=os.clock()

local function smoothstep(x)
x=YE_GenieClamp01(x)
return x*x*(3-2*x)
end

while true do
local raw=(os.clock()-started)/duration
local t=YE_GenieClamp01(raw)

local positionP
local sizeP
local layerMix
local scale=1
local centerOffset=Vector2.zero

if reverse then
local inv=1-t
local positionRestore=1-(inv^2.15)
local sizeRestore=1-(inv^1.55)

positionP=1-positionRestore
sizeP=1-sizeRestore
layerMix=1-smoothstep(t/0.42)

local springStart=0.78
if t>springStart then
local u=YE_GenieClamp01((t-springStart)/(1-springStart))
local s=math.sin(math.pi*u)
local bump=s*s
scale=1+(0.0075*bump)
centerOffset=morph.RestoreDirection*(1.6*bump)
end

local glowT=YE_GenieClamp01((t-0.03)/0.93)
local glowWave=math.sin(math.pi*glowT)
local diffuseStrength=0.30*(glowWave^0.90)
local edgeStrength=0.56*(glowWave^0.72)
morph.Glow.Diffuse.ImageTransparency=1-diffuseStrength
morph.Glow.Stroke.Transparency=1-edgeStrength
else
positionP=t*(0.50+0.50*t)
sizeP=t*(0.72+0.28*t)
layerMix=smoothstep((t-0.66)/0.34)

morph.Glow.Diffuse.ImageTransparency=1
morph.Glow.Stroke.Transparency=1
end

YE_GenieApplyGeometry(morph,positionP,scale,centerOffset,sizeP,layerMix)

if raw>=1 then
break
end

YE_GenieRunService.RenderStepped:Wait()
end

morph.Glow.Diffuse.ImageTransparency=1
morph.Glow.Stroke.Transparency=1
YE_GenieApplyGeometry(morph,reverse and 0 or 1,1,Vector2.zero,reverse and 0 or 1,reverse and 0 or 1)
end

local function YE_GenieJellyOpenButton(info,impactDirection)
if not info
or not info.Container
or not aw.OpenButtonMain
or not aw.Closed
or aw.Destroyed then
return
end

local container=info.Container
local scaleObj=info.ScaleObject
local basePos=info.BasePosition or container.Position
local baseScale=info.BaseScale or 1

local direction=impactDirection or Vector2.new(0,-1)
if typeof(direction)~="Vector2" or direction.Magnitude<0.001 then
direction=Vector2.new(0,-1)
else
direction=direction.Unit
end

local duration=0.125
local started=os.clock()

local function smoothstep(x)
x=YE_GenieClamp01(x)
return x*x*(3-2*x)
end

while true do
if not aw.Closed or aw.Destroyed or not container.Parent then
break
end

local t=YE_GenieClamp01((os.clock()-started)/duration)
local offset
local scaleDelta

if t<0.40 then
local u=smoothstep(t/0.40)
offset=3.8*u
scaleDelta=-0.008*u
elseif t<0.76 then
local u=smoothstep((t-0.40)/0.36)
offset=3.8+(-5.05*u)
scaleDelta=-0.008+(0.012*u)
else
local u=smoothstep((t-0.76)/0.24)
offset=-1.25+(1.25*u)
scaleDelta=0.004*(1-u)
end

container.Position=YE_GenieOffsetPosition(basePos,direction*offset)

if scaleObj then
scaleObj.Scale=baseScale*(1+scaleDelta)
end

if t>=1 then
break
end

YE_GenieRunService.RenderStepped:Wait()
end

if container.Parent then
container.Position=basePos
end

if scaleObj then
scaleObj.Scale=baseScale
end
end

