        return false
    end

    return yeEnsureFolder(YE_CACHE_FOLDER)
end

local function yeReadFile(path)
    if not yeCanReadFiles() then
        return nil
    end

    local okExists, exists = pcall(function()
        return isfile(path)
    end)

    if not okExists or not exists then
        return nil
    end

    local okRead, content = pcall(function()
        return readfile(path)
    end)

    if okRead and type(content) == "string" then
        return content
    end

    return nil
end

local function yeWriteFile(path, content)
    if not yeCanWriteFiles() or type(content) ~= "string" then
        return false
    end

    yeEnsureCoreCacheFolders()

    local ok = pcall(function()
        writefile(path, content)
    end)

    return ok
end

local function yeLooksLikeCoreSource(source)
    if type(source) ~= "string" or #source < 1000 then
        return false
    end

    -- Only reject obvious HTTP/error bodies. No version banner checks,
    -- no minified-variable signatures, no "all patches must match" gate.
    if source:find("404: Not Found", 1, true)
        or source:find("Repository not found", 1, true)
        or source:find("<html", 1, true) then
        return false
    end

    return true
end

local function yeSourceCompiles(source)
    if not yeLooksLikeCoreSource(source) then
        return false
    end

    local ok, chunk = pcall(function()
        return loadstring(source)
    end)

    return ok and type(chunk) == "function"
end

local function yeLooksLikePatchedSource(source)
    return yeLooksLikeCoreSource(source)
        and source:find(YE_WINDUI_PATCH_ID, 1, true) ~= nil
end

local function yeHttpGet(url)
    local lastError = "unknown HTTP error"

    if type(game.HttpGetAsync) == "function" then
        local ok, result = pcall(function()
            return game:HttpGetAsync(url)
        end)

        if ok and type(result) == "string" and #result > 0 then
            return result
        end

        lastError = tostring(result)
    end

    if type(game.HttpGet) == "function" then
        local ok, result = pcall(function()
            return game:HttpGet(url)
        end)

        if ok and type(result) == "string" and #result > 0 then
            return result
        end

        lastError = tostring(result)
    end

    error("[WindUI YePerf] HTTP failed: " .. lastError, 0)
end

local function yeHttpGetWithTimeout(url, timeoutSeconds)
    local finished = false
    local abandoned = false
    local result = nil
    local fetchError = nil

    local worker = task.spawn(function()
        local ok, value = pcall(yeHttpGet, url)

        if abandoned then
            return
        end

        if ok then
            result = value
        else
            fetchError = value
        end

        finished = true
    end)

    local started = os.clock()

    while not finished and os.clock() - started < timeoutSeconds do
        task.wait(0.05)
    end

    if not finished then
        abandoned = true

        if type(task.cancel) == "function" then
            pcall(task.cancel, worker)
        end

        return nil, "timeout"
    end

    return result, fetchError
end

local function yeFind(source, needle, init)
    if type(source) ~= "string" or type(needle) ~= "string" then
        return nil
    end

    return source:find(needle, init or 1, true)
end

local function yeReplaceOnce(source, oldText, newText, label)
    local startPos = yeFind(source, oldText, 1)

    if not startPos then
        return source, false, label
    end

    local endPos = startPos + #oldText - 1

    return source:sub(1, startPos - 1)
        .. newText
        .. source:sub(endPos + 1),
        true,
        label
end

local function yeReplaceOnceFrom(source, searchStart, oldText, newText, label)
    local startPos = yeFind(source, oldText, searchStart)

    if not startPos then
        return source, false, label
    end

    local endPos = startPos + #oldText - 1

    return source:sub(1, startPos - 1)
        .. newText
        .. source:sub(endPos + 1),
        true,
        label
end

local function yeReplaceRangeKeepEnd(
    source,
    searchStart,
    startMarker,
    endMarker,
    replacement,
    label
)
    local startPos = yeFind(source, startMarker, searchStart)

    if not startPos then
        return source, false, label
    end

    local endPos = yeFind(source, endMarker, startPos + #startMarker)

    if not endPos then
        return source, false, label
    end

    return source:sub(1, startPos - 1)
        .. replacement
        .. source:sub(endPos),
        true,
        label
end

