end

local function YE_GenieMakeWindowLayer(parent,shell,z)
local layer=Instance.new"CanvasGroup"
layer.Name="YeGenieWindowLayer"
layer.BackgroundTransparency=1
layer.GroupTransparency=0
layer.Size=UDim2.fromScale(1,1)
layer.Position=UDim2.fromOffset(0,0)
layer.ZIndex=z
layer.Parent=parent

local clone=shell:Clone()
clone.Name="WindowShell"
clone.AnchorPoint=Vector2.new(0.5,0.5)
clone.Position=UDim2.fromScale(0.5,0.5)
clone.Size=UDim2.fromScale(1,1)
clone.Active=false

-- Keep exactly one continuous background image. Remove resize/drag helpers
-- and every other shell child so there are no duplicated outlines or bands.
local keepBG=YE_GenieFindBGImage(clone)
for _,child in ipairs(clone:GetChildren())do
if child~=keepBG then
child:Destroy()
end
end

clone.ImageTransparency=aw.Transparent and av.WindUI.TransparencyValue or 0

if keepBG then
keepBG.ImageTransparency=aw.BackgroundImageTransparency or 0
keepBG.Active=false
end

YE_GenieSetInactive(clone,z+1)
clone.Parent=layer
return layer
end

