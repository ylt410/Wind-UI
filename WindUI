local function YE_GenieScreenSize()
local screen=av.WindUI and av.WindUI.ScreenGui
if screen and screen.AbsoluteSize.X>1 and screen.AbsoluteSize.Y>1 then
return screen.AbsoluteSize
end

local camera=workspace.CurrentCamera
return camera and camera.ViewportSize or Vector2.new(1920,1080)
end

local function YE_GenieResolveCenter(gui,visualSize)
if not gui then
return nil
end

local parent=gui.Parent
local origin=Vector2.zero
local parentSize=YE_GenieScreenSize()

while parent do
if parent:IsA"GuiObject"then
origin=parent.AbsolutePosition
parentSize=parent.AbsoluteSize
break
elseif parent:IsA"ScreenGui"then
origin=Vector2.zero
parentSize=parent.AbsoluteSize
break
end
parent=parent.Parent
end

local pos=gui.Position
local anchorPoint=Vector2.new(
origin.X+parentSize.X*pos.X.Scale+pos.X.Offset,
origin.Y+parentSize.Y*pos.Y.Scale+pos.Y.Offset
)

local a=gui.AnchorPoint
local size=visualSize or gui.AbsoluteSize
return Vector2.new(
anchorPoint.X+(0.5-a.X)*size.X,
anchorPoint.Y+(0.5-a.Y)*size.Y
)
end

local function YE_GenieOffsetPosition(base,delta)
return UDim2.new(
base.X.Scale,
base.X.Offset+delta.X,
base.Y.Scale,
base.Y.Offset+delta.Y
)
end

local function YE_GenieDirection(fromPoint,toPoint)
local delta=toPoint-fromPoint
local magnitude=delta.Magnitude
if magnitude<0.001 then
return Vector2.new(0,-1)
end
return delta/magnitude
end

local function YE_GenieGetButtonGeometry()
if not aw.OpenButtonMain or not aw.OpenButtonMain.Button then
return nil
end

local button=aw.OpenButtonMain.Button
local container=button.Parent
if not container then
return nil
end

local scaleObj=button:FindFirstChildOfClass"UIScale"
local baseScale=scaleObj and scaleObj.Scale or 1

local size=button.AbsoluteSize
if size.X<8 or size.Y<8 then
size=container.AbsoluteSize
end

if size.X<8 or size.Y<8 then
local textButton=button:FindFirstChild"TextButton"
local textSize=textButton and textButton.AbsoluteSize or Vector2.zero
local baseHeight=button.Size.Y.Offset>8 and button.Size.Y.Offset or 44
local baseWidth=textSize.X>8 and textSize.X or baseHeight

local drag=button:FindFirstChild"Drag"
if drag and drag.Visible and drag.AbsoluteSize.X>1 then
baseWidth=baseWidth+drag.AbsoluteSize.X
end

local divider=button:FindFirstChildWhichIsA"Frame"
if divider and divider.Name~="Drag" and divider.Visible and divider.AbsoluteSize.X<=4 then
baseWidth=baseWidth+divider.AbsoluteSize.X+4
end

size=Vector2.new(
math.max(28,baseWidth*baseScale),
math.max(28,baseHeight*baseScale)
)
end

local center=YE_GenieResolveCenter(container,size)
if not center then
return nil
end

return {
Button=button,
Container=container,
Center=center,
Size=size,
ScaleObject=scaleObj,
BaseScale=baseScale,
BasePosition=container.Position,
}
end

