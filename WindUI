    local fetched, fetchError =
        yeHttpGetWithTimeout(YE_OFFICIAL_URL, YE_CORE_HTTP_TIMEOUT)

    if not yeLooksLikeCoreSource(fetched) then
        -- If the timeout worker could not finish, make one normal request.
        -- This only affects a cold start with no usable local cache.
        local okFallback, fallback = pcall(yeHttpGet, YE_OFFICIAL_URL)

        if okFallback and yeLooksLikeCoreSource(fallback) then
            fetched = fallback
        else
            error(
                "[WindUI YePerf] unable to load official WindUI v"
                    .. YE_WINDUI_BASE_VERSION
                    .. ": "
                    .. tostring(fetchError or fallback),
                0
            )
        end
    end

    coreSource = fetched
    yeWriteFile(YE_CORE_CACHE, coreSource)
else
    print("[WindUI YePerf] using cached official source")
end

local optimizedSource = yePatchWindUI(coreSource)

if yeLooksLikePatchedSource(optimizedSource) then
    yeWriteFile(YE_PATCHED_CACHE, optimizedSource)
end

return yeCompileAndRun(optimizedSource)
