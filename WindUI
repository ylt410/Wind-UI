local function YE_GenieSetInactive(root,z)
if not root then
return
end

local rootZ=1
if root:IsA"GuiObject"then
rootZ=root.ZIndex
root.Active=false
root.ZIndex=z
end

for _,desc in ipairs(root:GetDescendants())do
