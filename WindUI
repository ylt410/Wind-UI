end

local function YE_GenieApplyGeometry(morph,minimizeProgress,visualScale,centerOffset)
local p=YE_GenieClamp01(minimizeProgress)
local scale=visualScale or 1
local offset=centerOffset or Vector2.zero

local cx=YE_GenieLerp(morph.WindowCenter.X,morph.ButtonCenter.X,p)+offset.X
local cy=YE_GenieLerp(morph.WindowCenter.Y,morph.ButtonCenter.Y,p)+offset.Y
local w=YE_GenieLerp(morph.WindowSize.X,morph.ButtonSize.X,p)*scale
local h=YE_GenieLerp(morph.WindowSize.Y,morph.ButtonSize.Y,p)*scale

morph.Group.Position=UDim2.fromOffset(cx,cy)
morph.Group.Size=UDim2.fromOffset(math.max(4,w),math.max(4,h))

local style=YE_GenieClamp01((p-0.72)/0.28)
morph.WindowLayer.GroupTransparency=style
morph.ButtonLayer.GroupTransparency=1-style
end

-- Base travel remains linear and fast. Restore gets only a short late spring.
-- The opening highlight is deliberately edge-only: a thin white stroke plus
-- a narrow diffuse outer halo. Both are forced fully transparent on the final
-- frame so the normal Window never keeps a glow.
local function YE_GenieRunMorph(morph,reverse,duration)
local started=os.clock()

while true do
local raw=(os.clock()-started)/duration
local t=YE_GenieClamp01(raw)
local p=reverse and(1-t)or t
local scale=1
local centerOffset=Vector2.zero

if reverse then
local springStart=0.72
if t>springStart then
local u=YE_GenieClamp01((t-springStart)/(1-springStart))
local envelope=(1-u)^1.55
local wave=math.sin(u*math.pi*2)
scale=1+(0.014*wave*envelope)
centerOffset=morph.RestoreDirection*(2.4*wave*envelope)
end

-- Fast fade-in, visible mid-animation, then disappear before the real
-- Window is handed back. The diffuse layer is intentionally narrow so it
-- reads as scattered edge light instead of a white fog over the content.
local glowT=YE_GenieClamp01((t-0.04)/0.90)
local glowWave=math.sin(math.pi*glowT)
local diffuseStrength=0.30*(glowWave^0.90)
local edgeStrength=0.56*(glowWave^0.72)
morph.Glow.Diffuse.ImageTransparency=1-diffuseStrength
morph.Glow.Stroke.Transparency=1-edgeStrength
else
morph.Glow.Diffuse.ImageTransparency=1
morph.Glow.Stroke.Transparency=1
end

YE_GenieApplyGeometry(morph,p,scale,centerOffset)

if raw>=1 then
break
end

YE_GenieRunService.RenderStepped:Wait()
end

-- Exact landing frame. No residual glow, overshoot or coordinate drift.
morph.Glow.Diffuse.ImageTransparency=1
morph.Glow.Stroke.Transparency=1
YE_GenieApplyGeometry(morph,reverse and 0 or 1,1,Vector2.zero)
end

-- One continuous damped oscillation along the actual incoming travel axis.
-- This is deliberately not a chain of Tween endpoints, which was what made
-- r7 look like a vibration instead of jelly inertia.
local function YE_GenieJellyOpenButton(info,impactDirection)
if not info
or not info.Container
or not aw.OpenButtonMain
or not aw.Closed
or aw.Destroyed then
return
end

local container=info.Container
local scaleObj=info.ScaleObject
local basePos=info.BasePosition or container.Position
local baseScale=info.BaseScale or 1
local direction=impactDirection or Vector2.new(0,-1)
local duration=0.150
local amplitude=5.4
local started=os.clock()

while true do
if not aw.Closed or aw.Destroyed or not container.Parent then
break
end

local raw=(os.clock()-started)/duration
local t=YE_GenieClamp01(raw)
local envelope=(1-t)^2.0
local wave=math.sin(t*math.pi*2.25)
local offset=direction*(amplitude*wave*envelope)

container.Position=YE_GenieOffsetPosition(basePos,offset)
if scaleObj then
scaleObj.Scale=baseScale*(1+0.010*wave*envelope)
end

if raw>=1 then
break
end
YE_GenieRunService.RenderStepped:Wait()
end

if container.Parent then
container.Position=basePos
end
if scaleObj then
scaleObj.Scale=baseScale
end
end

