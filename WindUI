local screen=av.WindUI and av.WindUI.ScreenGui
if not windowRoot or not shell or not buttonInfo or not screen then
return nil
end

local windowSize=windowRoot.AbsoluteSize
if windowSize.X<8 or windowSize.Y<8 then
local globalScale=av.WindUI.UIScale or 1
windowSize=Vector2.new(
math.max(8,aw.Size.X.Offset*globalScale),
math.max(8,aw.Size.Y.Offset*globalScale)
)
end

local windowCenter=YE_GenieResolveCenter(windowRoot,windowSize)
if not windowCenter then
return nil
end

local group=Instance.new"CanvasGroup"
group.Name="YeGenieJellyGlowMorph"
