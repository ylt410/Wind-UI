local function yeEnsureFolder(path)
    if type(isfolder) ~= "function" or type(makefolder) ~= "function" then
        return false
    end

    local okCheck, exists = pcall(function()
        return isfolder(path)
    end)

    if not okCheck then
        return false
    end

    if not exists then
        local okMake = pcall(function()
            makefolder(path)
        end)

        if not okMake then
            return false
        end
    end

    return true
end

local function yeEnsureCoreCacheFolders()
