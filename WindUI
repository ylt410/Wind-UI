-- One continuous rectangle only. The width and height use different curves:
-- width contracts earlier than height, producing a symmetric "funnel/squeeze"
-- impression without cutting the surface into strips.
local function YE_GenieApplyGeometry(morph,minimizeProgress)
local p=YE_GenieClamp01(minimizeProgress)
local moveE=YE_GenieSmoother(p)
local widthE=1-(1-p)^2.65
local heightE=YE_GenieSmoother(YE_GenieClamp01((p-0.08)/0.92))

local cx=YE_GenieLerp(morph.WindowCenter.X,morph.ButtonCenter.X,moveE)
local cy=YE_GenieLerp(morph.WindowCenter.Y,morph.ButtonCenter.Y,moveE)

local w=YE_GenieLerp(morph.WindowSize.X,morph.ButtonSize.X,widthE)
local h=YE_GenieLerp(morph.WindowSize.Y,morph.ButtonSize.Y,heightE)

-- Gentle symmetric squeeze in the middle. Both sides move inward by the
-- exact same amount; the center never shifts because of the deformation.
local squeeze=math.sin(math.pi*p)
local squeezeAmount=1-0.055*squeeze*squeeze
w=math.max(4,w*squeezeAmount)

morph.Group.Position=UDim2.fromOffset(cx,cy)
morph.Group.Size=UDim2.fromOffset(math.max(4,w),math.max(4,h))

local style=YE_GenieSmoother(YE_GenieClamp01((p-0.60)/0.40))
morph.WindowLayer.GroupTransparency=style
morph.ButtonLayer.GroupTransparency=1-style
end

local function YE_GenieRunMorph(morph,reverse,duration)
local started=os.clock()

while true do
local raw=(os.clock()-started)/duration
local t=YE_GenieClamp01(raw)
local p=reverse and(1-t)or t
YE_GenieApplyGeometry(morph,p)

if raw>=1 then
break
end

YE_GenieRunService.RenderStepped:Wait()
end
end

local function YE_GenieBounceOpenButton(info)
if not info
or not info.ScaleObject
or not aw.OpenButtonMain
or not aw.Closed
or aw.Destroyed then
return
end

local scaleObj=info.ScaleObject
local base=info.BaseScale or 1
scaleObj.Scale=base*0.80

local t1=YE_GenieTweenService:Create(
scaleObj,
TweenInfo.new(0.11,Enum.EasingStyle.Back,Enum.EasingDirection.Out),
{Scale=base*1.12}
)
t1:Play()
t1.Completed:Wait()

if not aw.Closed or aw.Destroyed then
scaleObj.Scale=base
return
end

local t2=YE_GenieTweenService:Create(
scaleObj,
TweenInfo.new(0.075,Enum.EasingStyle.Quad,Enum.EasingDirection.InOut),
{Scale=base*0.965}
)
t2:Play()
t2.Completed:Wait()

if not aw.Closed or aw.Destroyed then
scaleObj.Scale=base
return
end

YE_GenieTweenService:Create(
scaleObj,
TweenInfo.new(0.12,Enum.EasingStyle.Back,Enum.EasingDirection.Out),
{Scale=base}
):Play()
end

