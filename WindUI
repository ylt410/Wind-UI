local function YE_GenieSetInactive(root,z)
if not root then
return
end

local rootZ=1
if root:IsA"GuiObject"then
rootZ=root.ZIndex
root.Active=false
root.ZIndex=z
end

for _,desc in ipairs(root:GetDescendants())do
if desc:IsA"GuiObject"then
local delta=math.clamp(desc.ZIndex-rootZ,0,50)
desc.Active=false
desc.ZIndex=z+delta
end
end
end

local function YE_GenieGetButtonGeometry()
if not aw.OpenButtonMain or not aw.OpenButtonMain.Button then
return nil
end

local button=aw.OpenButtonMain.Button
local container=button.Parent
if not container then
return nil
end

local scaleObj=button:FindFirstChildOfClass"UIScale"
local baseScale=scaleObj and scaleObj.Scale or 1
local size=container.AbsoluteSize

if size.X<8 or size.Y<8 then
size=button.AbsoluteSize
end

if size.X<8 or size.Y<8 then
local textWidth=0
local textButton=button:FindFirstChild"TextButton"
if textButton then
textWidth=textButton.AbsoluteSize.X
end
size=Vector2.new(
math.max(64,(textWidth>1 and textWidth+44 or 132)*baseScale),
math.max(30,44*baseScale)
)
end

local pos=container.AbsolutePosition
local center

if container.AbsoluteSize.X>1 and container.AbsoluteSize.Y>1 then
center=Vector2.new(
pos.X+container.AbsoluteSize.X/2,
pos.Y+container.AbsoluteSize.Y/2
)
else
local screenSize=av.WindUI
and av.WindUI.ScreenGui
and av.WindUI.ScreenGui.AbsoluteSize
or Vector2.new(1920,1080)
local u=container.Position
center=Vector2.new(
screenSize.X*u.X.Scale+u.X.Offset,
screenSize.Y*u.Y.Scale+u.Y.Offset
)
end

return {
Button=button,
Container=container,
Center=center,
Size=size,
ScaleObject=scaleObj,
BaseScale=baseScale,
}
end

